@page "/referentiels/cycles"
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Cycles de formation" />
                <RadzenText Text="PREPA, BTS, LMD, Licence, Master, etc." />
            </RadzenStack>
            <RadzenButton Text="Nouveau cycle" Icon="add_circle" Click="@Create" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="CycleFormationDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Code" Name="Code" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Code" Text="Code obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="5">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Ordre" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.OrdreAffichage" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Actif" />
                            <RadzenCheckBox @bind-Value="@model.EstActif" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="CycleFormationDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="CycleFormationDto" Property="Code" Title="Code" />
                <RadzenDataGridColumn TItem="CycleFormationDto" Property="Libelle" Title="Libellé" />
                <RadzenDataGridColumn TItem="CycleFormationDto" Property="OrdreAffichage" Title="Ordre" />
                <RadzenDataGridColumn TItem="CycleFormationDto" Property="EstActif" Title="Actif">
                    <Template Context="item"><RadzenCheckBox Value="@item.EstActif" Disabled="true" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CycleFormationDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<CycleFormationDto> items = [];
    private CycleFormationDto model = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await ReferentielsService.GetCyclesFormationAsync();
    }

    private void Create()
    {
        model = ReferentielsService.CreateDefaultCycleFormation();
        showForm = true;
    }

    private void Edit(CycleFormationDto item)
    {
        model = new CycleFormationDto
        {
            Id = item.Id,
            Code = item.Code,
            Libelle = item.Libelle,
            OrdreAffichage = item.OrdreAffichage,
            EstActif = item.EstActif
        };
        showForm = true;
    }

    private async Task Save(CycleFormationDto _)
    {
        try
        {
            await ReferentielsService.SaveCycleFormationAsync(model);
            NotifySuccess();
            showForm = false;
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(CycleFormationDto item)
    {
        try
        {
            await ReferentielsService.DeleteCycleFormationAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
