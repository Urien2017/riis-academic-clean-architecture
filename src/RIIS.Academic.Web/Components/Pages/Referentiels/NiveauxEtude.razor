@page "/referentiels/niveaux"
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Niveaux d'étude" />
                <RadzenText Text="Gestion des niveaux pédagogiques." />
            </RadzenStack>
            <RadzenButton Text="Nouveau niveau" Icon="add_circle" Click="@Create" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="NiveauEtudeDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Numéro" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.Numero" Name="Numero" Min="1" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="7">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Actif" />
                            <RadzenCheckBox @bind-Value="@model.EstActif" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="NiveauEtudeDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="NiveauEtudeDto" Property="Numero" Title="Numéro" />
                <RadzenDataGridColumn TItem="NiveauEtudeDto" Property="Libelle" Title="Libellé" />
                <RadzenDataGridColumn TItem="NiveauEtudeDto" Property="EstActif" Title="Actif">
                    <Template Context="item"><RadzenCheckBox Value="@item.EstActif" Disabled="true" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="NiveauEtudeDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<NiveauEtudeDto> items = [];
    private NiveauEtudeDto model = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await ReferentielsService.GetNiveauxEtudeAsync();
    }

    private async Task Create()
    {
        model = await ReferentielsService.CreateDefaultNiveauEtudeAsync();
        showForm = true;
    }

    private void Edit(NiveauEtudeDto item)
    {
        model = new NiveauEtudeDto
        {
            Id = item.Id,
            Numero = item.Numero,
            Libelle = item.Libelle,
            EstActif = item.EstActif
        };
        showForm = true;
    }

    private async Task Save(NiveauEtudeDto _)
    {
        try
        {
            await ReferentielsService.SaveNiveauEtudeAsync(model);
            NotifySuccess();
            showForm = false;
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(NiveauEtudeDto item)
    {
        try
        {
            await ReferentielsService.DeleteNiveauEtudeAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
