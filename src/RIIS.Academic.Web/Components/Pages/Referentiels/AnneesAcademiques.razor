@page "/referentiels/annees"
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Années académiques" />
                <RadzenText Text="Gestion des périodes académiques." />
            </RadzenStack>
            <RadzenButton Text="Nouvelle année" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="AnneeAcademiqueDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Le libellé est obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Année début" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.AnneeDebut" Name="AnneeDebut" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Année fin" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.AnneeFin" Name="AnneeFin" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenStack Gap="0.5rem">
                                <RadzenLabel Text="Active" />
                                <RadzenCheckBox @bind-Value="@model.EstActive" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="AnneeAcademiqueDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="AnneeAcademiqueDto" Property="Libelle" Title="Libellé" />
                <RadzenDataGridColumn TItem="AnneeAcademiqueDto" Property="AnneeDebut" Title="Début" />
                <RadzenDataGridColumn TItem="AnneeAcademiqueDto" Property="AnneeFin" Title="Fin" />
                <RadzenDataGridColumn TItem="AnneeAcademiqueDto" Property="EstActive" Title="Active">
                    <Template Context="item">
                        <RadzenCheckBox Value="@item.EstActive" Disabled="true" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AnneeAcademiqueDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<AnneeAcademiqueDto> items = [];
    private AnneeAcademiqueDto model = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await ReferentielsService.GetAnneesAcademiquesAsync();
    }

    private void Create()
    {
        model = ReferentielsService.CreateDefaultAnneeAcademique();
        showForm = true;
    }

    private void Edit(AnneeAcademiqueDto item)
    {
        model = new AnneeAcademiqueDto
        {
            Id = item.Id,
            Libelle = item.Libelle,
            AnneeDebut = item.AnneeDebut,
            AnneeFin = item.AnneeFin,
            EstActive = item.EstActive
        };
        showForm = true;
    }

    private async Task Save(AnneeAcademiqueDto _)
    {
        try
        {
            await ReferentielsService.SaveAnneeAcademiqueAsync(model);
            NotifySuccess();
            showForm = false;
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(AnneeAcademiqueDto item)
    {
        try
        {
            await ReferentielsService.DeleteAnneeAcademiqueAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
