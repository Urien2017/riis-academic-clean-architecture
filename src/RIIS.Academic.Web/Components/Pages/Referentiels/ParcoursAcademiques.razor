@page "/referentiels/parcours-academiques"
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Parcours academiques" />
                <RadzenText Text="Gestion des parcours par annee, cycle, niveau, filiere et specialite." />
            </RadzenStack>
            <RadzenButton Text="Nouveau parcours" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanCreate)" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres" />
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Annee academique" Style="width:100%">
                        <RadzenDropDown Data="@anneesAcademiques" @bind-Value="@filtreAnneeAcademiqueId" TextProperty="Libelle" ValueProperty="Id" TValue="long?" AllowClear="true" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Cycle" Style="width:100%">
                        <RadzenDropDown Data="@cycles" @bind-Value="@filtreCycleFormationId" TextProperty="Libelle" ValueProperty="Id" TValue="long?" AllowClear="true" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenFormField Text="Niveau" Style="width:100%">
                        <RadzenDropDown Data="@niveaux" @bind-Value="@filtreNiveauEtudeId" TextProperty="Libelle" ValueProperty="Id" TValue="long?" AllowClear="true" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenFormField Text="Filiere" Style="width:100%">
                        <RadzenDropDown Data="@filieres" @bind-Value="@FiltreFiliereId" TextProperty="Libelle" ValueProperty="Id" TValue="long?" AllowClear="true" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenFormField Text="Specialite" Style="width:100%">
                        <RadzenDropDown Data="@FilterSpecialites" @bind-Value="@filtreSpecialiteId" TextProperty="Libelle" ValueProperty="Id" TValue="long?" AllowClear="true" Disabled="@(!filtreFiliereId.HasValue)" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenCheckBox @bind-Value="@inclureInactifs" />
                    <RadzenText Text="Inclure inactifs" />
                </RadzenStack>
                <RadzenButton Text="Filtrer" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@LoadParcours" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (!CanCreate)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
            Les referentiels annee, cycle, niveau, filiere et specialite sont obligatoires avant de creer un parcours.
        </RadzenAlert>
    }

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="ParcoursAcademiqueDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox Value="@model.Code" Name="Code" ReadOnly="true" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Libelle" Style="width:100%">
                                <RadzenTextBox Value="@model.Libelle" Name="Libelle" ReadOnly="true" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Annee academique" Style="width:100%">
                                <RadzenDropDown Data="@anneesAcademiques" @bind-Value="@model.AnneeAcademiqueId" TextProperty="Libelle" ValueProperty="Id" TValue="long" Name="AnneeAcademiqueId" Change="@OnModelSelectionChanged" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="AnneeAcademiqueId" Text="Annee obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Cycle" Style="width:100%">
                                <RadzenDropDown Data="@cycles" @bind-Value="@model.CycleFormationId" TextProperty="Libelle" ValueProperty="Id" TValue="long" Name="CycleFormationId" Change="@OnModelSelectionChanged" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="CycleFormationId" Text="Cycle obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Niveau" Style="width:100%">
                                <RadzenDropDown Data="@niveaux" @bind-Value="@model.NiveauEtudeId" TextProperty="Libelle" ValueProperty="Id" TValue="long" Name="NiveauEtudeId" Change="@OnModelSelectionChanged" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="NiveauEtudeId" Text="Niveau obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Filiere" Style="width:100%">
                                <RadzenDropDown Data="@filieres" @bind-Value="@ModelFiliereId" TextProperty="Libelle" ValueProperty="Id" TValue="long" Name="FiliereId" Change="@OnModelSelectionChanged" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="FiliereId" Text="Filiere obligatoire." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Specialite" Style="width:100%">
                                <RadzenDropDown Data="@ModelSpecialites" @bind-Value="@model.SpecialiteId" TextProperty="Libelle" ValueProperty="Id" TValue="long" Name="SpecialiteId" Change="@OnModelSelectionChanged" Disabled="@(model.FiliereId <= 0)" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="SpecialiteId" Text="Specialite obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="height:100%">
                                <RadzenCheckBox @bind-Value="@model.EstActive" />
                                <RadzenText Text="Actif" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="ParcoursAcademiqueDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="Code" Title="Code" Width="190px" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="AnneeAcademiqueLibelle" Title="Annee" Width="130px" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="CycleLibelle" Title="Cycle" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="NiveauLibelle" Title="Niveau" Width="120px" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="FiliereLibelle" Title="Filiere" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Property="SpecialiteLibelle" Title="Specialite" />
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Title="Actif" Width="90px">
                    <Template Context="item"><RadzenCheckBox Value="@item.EstActive" Disabled="true" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ParcoursAcademiqueDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<ParcoursAcademiqueDto> items = [];
    private List<AnneeAcademiqueDto> anneesAcademiques = [];
    private List<CycleFormationDto> cycles = [];
    private List<NiveauEtudeDto> niveaux = [];
    private List<FiliereDto> filieres = [];
    private List<SpecialiteDto> specialites = [];
    private ParcoursAcademiqueDto model = new();
    private long? filtreAnneeAcademiqueId;
    private long? filtreCycleFormationId;
    private long? filtreNiveauEtudeId;
    private long? filtreFiliereId;
    private long? filtreSpecialiteId;
    private bool inclureInactifs;
    private bool showForm;

    private bool CanCreate
        => anneesAcademiques.Count > 0
            && cycles.Count > 0
            && niveaux.Count > 0
            && filieres.Count > 0
            && specialites.Count > 0;

    private IEnumerable<SpecialiteDto> FilterSpecialites
        => filtreFiliereId.HasValue
            ? specialites.Where(x => x.FiliereId == filtreFiliereId.Value)
            : Enumerable.Empty<SpecialiteDto>();

    private IEnumerable<SpecialiteDto> ModelSpecialites
        => model.FiliereId > 0
            ? specialites.Where(x => x.FiliereId == model.FiliereId)
            : Enumerable.Empty<SpecialiteDto>();

    private long? FiltreFiliereId
    {
        get => filtreFiliereId;
        set
        {
            filtreFiliereId = value;

            if (filtreSpecialiteId.HasValue && !FilterSpecialites.Any(x => x.Id == filtreSpecialiteId.Value))
            {
                filtreSpecialiteId = null;
            }
        }
    }

    private long ModelFiliereId
    {
        get => model.FiliereId;
        set
        {
            model.FiliereId = value;

            if (model.SpecialiteId > 0 && !ModelSpecialites.Any(x => x.Id == model.SpecialiteId))
            {
                model.SpecialiteId = 0;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReferentiels();
        await LoadParcours();
    }

    private async Task LoadReferentiels()
    {
        anneesAcademiques = await ReferentielsService.GetAnneesAcademiquesAsync();
        cycles = await ReferentielsService.GetCyclesFormationAsync();
        niveaux = await ReferentielsService.GetNiveauxEtudeAsync();
        filieres = await ReferentielsService.GetFilieresAsync();
        specialites = await ReferentielsService.GetSpecialitesAsync();
    }

    private async Task LoadParcours()
    {
        items = await ReferentielsService.GetParcoursAcademiquesAsync(
            filtreAnneeAcademiqueId,
            filtreCycleFormationId,
            filtreNiveauEtudeId,
            filtreFiliereId,
            filtreSpecialiteId,
            inclureInactifs);
    }

    private async Task Create()
    {
        model = ReferentielsService.CreateDefaultParcoursAcademique(filtreAnneeAcademiqueId);
        model.AnneeAcademiqueId = model.AnneeAcademiqueId == 0 ? anneesAcademiques.FirstOrDefault(x => x.EstActive)?.Id ?? anneesAcademiques.First().Id : model.AnneeAcademiqueId;
        model.CycleFormationId = filtreCycleFormationId ?? cycles.First().Id;
        model.NiveauEtudeId = filtreNiveauEtudeId ?? niveaux.First().Id;
        model.FiliereId = filtreFiliereId ?? filieres.First().Id;
        model.SpecialiteId = filtreSpecialiteId ?? ModelSpecialites.FirstOrDefault()?.Id ?? 0;
        SyncGeneratedFields();
        showForm = true;
    }

    private async Task Edit(ParcoursAcademiqueDto item)
    {
        model = new ParcoursAcademiqueDto
        {
            Id = item.Id,
            AnneeAcademiqueId = item.AnneeAcademiqueId,
            AnneeAcademiqueLibelle = item.AnneeAcademiqueLibelle,
            AnneeDebut = item.AnneeDebut,
            CycleFormationId = item.CycleFormationId,
            CycleCode = item.CycleCode,
            CycleLibelle = item.CycleLibelle,
            NiveauEtudeId = item.NiveauEtudeId,
            NiveauNumero = item.NiveauNumero,
            NiveauLibelle = item.NiveauLibelle,
            FiliereId = item.FiliereId,
            FiliereCode = item.FiliereCode,
            FiliereLibelle = item.FiliereLibelle,
            SpecialiteId = item.SpecialiteId,
            SpecialiteCode = item.SpecialiteCode,
            SpecialiteLibelle = item.SpecialiteLibelle,
            Code = item.Code,
            Libelle = item.Libelle,
            EstActive = item.EstActive
        };
        SyncGeneratedFields();
        showForm = true;
    }

    private async Task Save(ParcoursAcademiqueDto _)
    {
        try
        {
            SyncGeneratedFields();
            await ReferentielsService.SaveParcoursAcademiqueAsync(model);
            NotifySuccess();
            showForm = false;
            await LoadParcours();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(ParcoursAcademiqueDto item)
    {
        try
        {
            await ReferentielsService.DeleteParcoursAcademiqueAsync(item.Id);
            await LoadParcours();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void OnModelSelectionChanged(object? _) => SyncGeneratedFields();

    private void SyncGeneratedFields()
    {
        var annee = anneesAcademiques.FirstOrDefault(x => x.Id == model.AnneeAcademiqueId);
        var cycle = cycles.FirstOrDefault(x => x.Id == model.CycleFormationId);
        var niveau = niveaux.FirstOrDefault(x => x.Id == model.NiveauEtudeId);
        var filiere = filieres.FirstOrDefault(x => x.Id == model.FiliereId);
        var specialite = specialites.FirstOrDefault(x => x.Id == model.SpecialiteId);

        if (annee is null || cycle is null || niveau is null || filiere is null || specialite is null)
        {
            model.Code = string.Empty;
            model.Libelle = string.Empty;
            return;
        }

        model.AnneeAcademiqueLibelle = annee.Libelle;
        model.AnneeDebut = annee.AnneeDebut;
        model.CycleCode = cycle.Code;
        model.CycleLibelle = cycle.Libelle;
        model.NiveauNumero = niveau.Numero;
        model.NiveauLibelle = niveau.Libelle;
        model.FiliereCode = filiere.Code;
        model.FiliereLibelle = filiere.Libelle;
        model.SpecialiteCode = specialite.Code;
        model.SpecialiteLibelle = specialite.Libelle;
        model.Code = $"{annee.AnneeDebut % 100:00}-{cycle.Code}-N{niveau.Numero}-{filiere.Code}-{specialite.Code}".ToUpperInvariant();
        model.Libelle = $"{annee.Libelle} - {cycle.Libelle} {niveau.Libelle} - {filiere.Libelle} - {specialite.Libelle}";
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succes", "Donnees enregistrees.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
