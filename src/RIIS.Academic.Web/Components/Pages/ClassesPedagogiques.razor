@page "/classes-pedagogiques"
@inject IClassesPedagogiquesService ClassesPedagogiquesService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Classes pédagogiques" />
                <RadzenText Text="Gestion des groupes pédagogiques par année, parcours et niveau." />
            </RadzenStack>
            <RadzenButton Text="Nouvelle classe" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem">
            <RadzenFormField Text="Année académique" Style="width: min(100%, 360px)">
                <RadzenDropDown Data="@annees"
                                TextProperty="Libelle"
                                ValueProperty="Id"
                                @bind-Value="@selectedAnneeAcademiqueId"
                                AllowClear="true"
                                Placeholder="Toutes les années"
                                Style="width:100%" />
            </RadzenFormField>
            <RadzenButton Text="Filtrer" Icon="filter_alt" Click="@Load" />
            <RadzenButton Text="Réinitialiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetFilter" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="ClassePedagogiqueDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Année académique" Style="width:100%">
                                <RadzenDropDown Data="@annees" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@model.AnneeAcademiqueId" Name="AnneeAcademiqueId" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="AnneeAcademiqueId" Text="Année obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Parcours" Style="width:100%">
                                <RadzenDropDown Data="@parcours" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@model.ParcoursAcademiqueId" Name="ParcoursAcademiqueId" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="ParcoursAcademiqueId" Text="Parcours obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Niveau" Style="width:100%">
                                <RadzenDropDown Data="@niveaux" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@model.NiveauEtudeId" Name="NiveauEtudeId" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="NiveauEtudeId" Text="Niveau obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Maquette" Style="width:100%">
                                <RadzenDropDown Data="@maquettes"
                                                TextProperty="Libelle"
                                                ValueProperty="Id"
                                                @bind-Value="@model.MaquettePedagogiqueId"
                                                AllowClear="true"
                                                Placeholder="Aucune maquette"
                                                Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Code" Name="Code" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Code" Text="Code obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="7">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenStack Gap="0.5rem">
                                <RadzenLabel Text="Active" />
                                <RadzenCheckBox @bind-Value="@model.EstActive" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="ClassePedagogiqueDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="AnneeAcademiqueLibelle" Title="Année" Width="140px" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="Code" Title="Code" Width="160px" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="Libelle" Title="Libellé" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="ParcoursAcademiqueLibelle" Title="Parcours" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="NiveauEtudeLibelle" Title="Niveau" Width="140px" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="Effectif" Title="Effectif" Width="110px" />
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Property="EstActive" Title="Active" Width="100px">
                    <Template Context="item"><RadzenCheckBox Value="@item.EstActive" Disabled="true" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ClassePedagogiqueDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<ClassePedagogiqueDto> items = [];
    private List<LookupDto> annees = [];
    private List<LookupDto> parcours = [];
    private List<LookupDto> niveaux = [];
    private List<LookupDto> maquettes = [];
    private ClassePedagogiqueDto model = new();
    private long? selectedAnneeAcademiqueId;
    private bool showForm;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        annees = await ClassesPedagogiquesService.GetAnneesAcademiquesLookupAsync();
        parcours = await ClassesPedagogiquesService.GetParcoursAcademiquesLookupAsync();
        niveaux = await ClassesPedagogiquesService.GetNiveauxEtudeLookupAsync();
        maquettes = await ClassesPedagogiquesService.GetMaquettesPedagogiquesLookupAsync();
    }

    private async Task Load()
    {
        items = await ClassesPedagogiquesService.GetClassesPedagogiquesAsync(selectedAnneeAcademiqueId);
    }

    private async Task ResetFilter()
    {
        selectedAnneeAcademiqueId = null;
        await Load();
    }

    private async Task Create()
    {
        model = await ClassesPedagogiquesService.CreateDefaultClassePedagogiqueAsync();
        showForm = true;
    }

    private void Edit(ClassePedagogiqueDto item)
    {
        model = new ClassePedagogiqueDto
        {
            Id = item.Id,
            AnneeAcademiqueId = item.AnneeAcademiqueId,
            AnneeAcademiqueLibelle = item.AnneeAcademiqueLibelle,
            ParcoursAcademiqueId = item.ParcoursAcademiqueId,
            ParcoursAcademiqueLibelle = item.ParcoursAcademiqueLibelle,
            NiveauEtudeId = item.NiveauEtudeId,
            NiveauEtudeLibelle = item.NiveauEtudeLibelle,
            MaquettePedagogiqueId = item.MaquettePedagogiqueId,
            MaquettePedagogiqueLibelle = item.MaquettePedagogiqueLibelle,
            Code = item.Code,
            Libelle = item.Libelle,
            EstActive = item.EstActive,
            Effectif = item.Effectif
        };
        showForm = true;
    }

    private async Task Save(ClassePedagogiqueDto _)
    {
        try
        {
            await ClassesPedagogiquesService.SaveClassePedagogiqueAsync(model);
            NotifySuccess();
            showForm = false;
            await LoadLookups();
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(ClassePedagogiqueDto item)
    {
        try
        {
            await ClassesPedagogiquesService.DeleteClassePedagogiqueAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
