@page "/scolarite/finances"
@inject IDossiersScolariteService DossiersScolariteService
@inject IFinancesScolariteService FinancesScolariteService
@inject IReferentielsService ReferentielsService
@inject IModesPaiementScolariteService ModesPaiementScolariteService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Gestion financière" />
                <RadzenText Text="Suivi des soldes, échéances et paiements des dossiers scolarité." />
            </RadzenStack>

            <RadzenButton Text="Actualiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@Load" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres" />

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Nom ou matricule" Style="width:100%">
                        <RadzenTextBox @bind-Value="@recherche" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Année académique" Style="width:100%">
                        <RadzenDropDown Data="@anneesAcademiques"
                                        @bind-Value="@filtreAnneeAcademiqueCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Libelle"
                                        TValue="string"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Cycle" Style="width:100%">
                        <RadzenDropDown Data="@cycleOptions"
                                        @bind-Value="@FiltreCycleCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Niveau" Style="width:100%">
                        <RadzenDropDown Data="@niveaux"
                                        @bind-Value="@filtreNiveauNumero"
                                        TextProperty="Libelle"
                                        ValueProperty="Numero"
                                        TValue="int?"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Filière" Style="width:100%">
                        <RadzenDropDown Data="@filiereOptions"
                                        @bind-Value="@FiltreFiliereCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Disabled="@(filiereOptions.Count == 0)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Spécialité" Style="width:100%">
                        <RadzenDropDown Data="@specialiteOptions"
                                        @bind-Value="@filtreSpecialiteCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Disabled="@(specialiteOptions.Count == 0)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="height:100%">
                        <RadzenButton Text="Réinitialiser" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="@ResetFilters" />
                        <RadzenButton Text="Filtrer" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@Load" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="DossierScolariteDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="DossierScolariteDto" Property="EtudiantNomComplet" Title="Étudiant" />
                <RadzenDataGridColumn TItem="DossierScolariteDto" Property="EtudiantMatricule" Title="Matricule" Width="140px" />
                <RadzenDataGridColumn TItem="DossierScolariteDto" Property="AnneeAcademiqueLibelle" Title="Année" Width="130px" />
                <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Parcours">
                    <Template Context="item">
                        <RadzenText Text="@DisplayParcours(item)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Statut financier" Width="150px">
                    <Template Context="item">
                        <RadzenBadge Text="@DisplayStatut(item.StatutFinancier)" BadgeStyle="@GetStatutBadgeStyle(item.StatutFinancier)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Actions" Width="150px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Text="Gérer"
                                      Icon="payments"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(!item.Existe)"
                                      Click="@(() => SelectDossier(item))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    @if (selectedDossier is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="@selectedDossier.EtudiantNomComplet" />
                        <RadzenText Text="@($"{selectedDossier.AnneeAcademiqueLibelle} - {DisplayParcours(selectedDossier)}")" />
                    </RadzenStack>
                    <RadzenBadge Text="@DisplayStatut(selectedDossier.StatutFinancier)" BadgeStyle="@GetStatutBadgeStyle(selectedDossier.StatutFinancier)" />
                </RadzenStack>

                @if (finance is null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                        Les données financières ne sont pas encore chargées pour ce dossier.
                    </RadzenAlert>
                }
                else
                {
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="Total attendu" />
                            <RadzenText Text="@FormatMoney(TotalAttendu(finance))" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="Paiements reçus" />
                            <RadzenText Text="@FormatMoney(finance.TotalPaiements)" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="Solde restant" />
                            <RadzenText Text="@FormatMoney(SoldeRestant(finance))" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="Paiements non affectés" />
                            <RadzenText Text="@FormatMoney(finance.TotalPaiementsNonAffectes)" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Gap="0.75rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Paiement libre" />
                        @if (optionsPaiement.Count == 0)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                                Aucun type d'élément payable avec tarif applicable n'est disponible pour ce dossier.
                            </RadzenAlert>
                        }
                        @if (modesPaiement.Count == 0)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
                                Aucun mode de paiement actif n'est disponible. Crée un mode de paiement avant d'enregistrer un paiement.
                            </RadzenAlert>
                        }

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Type d'élément / tarif" Style="width:100%">
                                    <RadzenDropDown Data="@optionsPaiement"
                                                    @bind-Value="@optionPaiementTarifId"
                                                    TextProperty="Libelle"
                                                    ValueProperty="TarifScolariteId"
                                                    TValue="long?"
                                                    AllowClear="true"
                                                    Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenFormField Text="Date" Style="width:100%">
                                    <RadzenDatePicker @bind-Value="@datePaiementLibre" DateFormat="dd/MM/yyyy" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenFormField Text="Montant" Style="width:100%">
                                    <RadzenNumeric @bind-Value="@montantPaiementLibre" TValue="decimal" Min="0" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Mode de paiement" Style="width:100%">
                                    <RadzenDropDown Data="@modesPaiement"
                                                    @bind-Value="@modePaiementScolariteId"
                                                    TextProperty="Libelle"
                                                    ValueProperty="Id"
                                                    TValue="long?"
                                                    AllowClear="true"
                                                    Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Référence" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@referencePaiementLibre" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Nature / commentaire" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@observationPaiementLibre" Style="width:100%" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <RadzenButton Text="Enregistrer paiement"
                                          Icon="payments"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Disabled="@(optionPaiementTarifId is null || modePaiementScolariteId is null)"
                                          Click="@EnregistrerPaiementLibre" />
                        </RadzenStack>
                    </RadzenStack>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="Échéances" />
                            <RadzenDataGrid Data="@finance.Echeances" TItem="EcheanceFinanciereDossierDto" AllowPaging="true" PageSize="5">
                                <Columns>
                                    <RadzenDataGridColumn TItem="EcheanceFinanciereDossierDto" Property="Libelle" Title="Échéance" />
                                    <RadzenDataGridColumn TItem="EcheanceFinanciereDossierDto" Title="Date">
                                        <Template Context="item">@item.DateExigibilite.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EcheanceFinanciereDossierDto" Title="Restant">
                                        <Template Context="item">@FormatMoney(item.MontantRestant)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="Paiements" />
                            <RadzenDataGrid Data="@finance.Paiements" TItem="PaiementLibreDossierDto" AllowPaging="true" PageSize="5">
                                <Columns>
                                    <RadzenDataGridColumn TItem="PaiementLibreDossierDto" Title="Date">
                                        <Template Context="item">@item.DatePaiement.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="PaiementLibreDossierDto" Title="Montant">
                                        <Template Context="item">@FormatMoney(item.Montant)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="PaiementLibreDossierDto" Property="TypeElementScolariteLibelle" Title="Type" />
                                    <RadzenDataGridColumn TItem="PaiementLibreDossierDto" Property="ModePaiement" Title="Mode" />
                                    <RadzenDataGridColumn TItem="PaiementLibreDossierDto" Title="Non affecté">
                                        <Template Context="item">@FormatMoney(item.MontantNonAffecte)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private List<AnneeAcademiqueDto> anneesAcademiques = [];
    private List<NiveauOption> niveaux = [];
    private List<ParcoursFormationDto> parcoursFormation = [];
    private List<CodeLibelleOption> cycleOptions = [];
    private List<CodeLibelleOption> filiereOptions = [];
    private List<CodeLibelleOption> specialiteOptions = [];
    private List<DossierScolariteDto> items = [];
    private List<PaiementTypeElementTarifOptionDto> optionsPaiement = [];
    private List<ModePaiementScolariteDto> modesPaiement = [];
    private DossierScolariteDto? selectedDossier;
    private FinanceDossierScolariteDto? finance;
    private long? optionPaiementTarifId;
    private long? modePaiementScolariteId;
    private DateTime? datePaiementLibre = DateTime.Today;
    private decimal montantPaiementLibre;
    private string? referencePaiementLibre;
    private string? observationPaiementLibre;
    private string? recherche;
    private string? filtreAnneeAcademiqueCode;
    private string? filtreCycleCode;
    private int? filtreNiveauNumero;
    private string? filtreFiliereCode;
    private string? filtreSpecialiteCode;

    protected override async Task OnInitializedAsync()
    {
        anneesAcademiques = await ReferentielsService.GetAnneesAcademiquesAsync();
        niveaux = (await ReferentielsService.GetNiveauxEtudeAsync())
            .Select(x => new NiveauOption(x.Numero, x.Libelle))
            .OrderBy(x => x.Numero)
            .ToList();
        parcoursFormation = await ReferentielsService.GetParcoursFormationAsync(inclureInactifs: true);
        RefreshParcoursOptions();
        await Load();
    }

    private async Task Load()
    {
        items = await DossiersScolariteService.GetDossiersScolariteAsync(
            inclureInscriptionsSansDossier: false,
            recherche: recherche,
            anneeAcademiqueCode: filtreAnneeAcademiqueCode,
            cycleCode: filtreCycleCode,
            niveauNumero: filtreNiveauNumero,
            filiereCode: filtreFiliereCode,
            specialiteCode: filtreSpecialiteCode);

        if (selectedDossier is not null)
        {
            selectedDossier = items.FirstOrDefault(x => x.Id == selectedDossier.Id);
            if (selectedDossier is not null)
            {
                await LoadFinance();
            }
            else
            {
                finance = null;
            }
        }
    }

    private async Task ResetFilters()
    {
        recherche = null;
        filtreAnneeAcademiqueCode = null;
        filtreCycleCode = null;
        filtreNiveauNumero = null;
        filtreFiliereCode = null;
        filtreSpecialiteCode = null;
        RefreshParcoursOptions();
        await Load();
    }

    private async Task SelectDossier(DossierScolariteDto item)
    {
        selectedDossier = item;
        await LoadFinance();
    }

    private async Task LoadFinance()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            finance = null;
            return;
        }

        await LoadFinanceLookups();
        finance = await FinancesScolariteService.GetFinanceDossierScolariteAsync(selectedDossier.Id);
        RefreshFinanceDefaults();
    }

    private async Task LoadFinanceLookups()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            optionsPaiement = [];
            modesPaiement = [];
            return;
        }

        optionsPaiement = await FinancesScolariteService.GetOptionsTypesElementsTarifsPaiementAsync(selectedDossier.Id);
        modesPaiement = await ModesPaiementScolariteService.GetModesPaiementScolariteAsync();

        if (optionPaiementTarifId is not null && optionsPaiement.All(x => x.TarifScolariteId != optionPaiementTarifId))
        {
            optionPaiementTarifId = null;
        }

        if (modePaiementScolariteId is not null && modesPaiement.All(x => x.Id != modePaiementScolariteId))
        {
            modePaiementScolariteId = null;
        }
    }

    private async Task EnregistrerPaiementLibre()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            return;
        }

        try
        {
            var option = optionsPaiement.FirstOrDefault(x => x.TarifScolariteId == optionPaiementTarifId)
                ?? throw new InvalidOperationException("Le type d'élément et le tarif du paiement sont obligatoires.");

            finance = await FinancesScolariteService.SavePaiementLibreAsync(new PaiementLibreDossierDto
            {
                DossierScolariteId = selectedDossier.Id,
                TypeElementScolariteId = option.TypeElementScolariteId,
                TarifScolariteId = option.TarifScolariteId,
                ModePaiementScolariteId = modePaiementScolariteId
                    ?? throw new InvalidOperationException("Le mode de paiement est obligatoire."),
                DatePaiement = DateOnly.FromDateTime(datePaiementLibre ?? DateTime.Today),
                Montant = montantPaiementLibre,
                ReferencePaiement = referencePaiementLibre,
                Observation = observationPaiementLibre
            });

            selectedDossier = await DossiersScolariteService.GetDossierScolariteAsync(selectedDossier.Id) ?? selectedDossier;
            montantPaiementLibre = 0;
            referencePaiementLibre = null;
            observationPaiementLibre = null;
            RefreshFinanceDefaults();
            NotifySuccess("Paiement libre enregistré.");
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void RefreshFinanceDefaults()
    {
        if (finance is null)
        {
            return;
        }

        optionPaiementTarifId = optionPaiementTarifId is not null && optionsPaiement.Any(x => x.TarifScolariteId == optionPaiementTarifId)
            ? optionPaiementTarifId
            : null;
        modePaiementScolariteId = modePaiementScolariteId is not null && modesPaiement.Any(x => x.Id == modePaiementScolariteId)
            ? modePaiementScolariteId
            : null;
    }

    private string? FiltreCycleCode
    {
        get => filtreCycleCode;
        set
        {
            filtreCycleCode = NormalizeNullable(value);

            if (!string.IsNullOrWhiteSpace(filtreFiliereCode) && !FiliereBelongsToCycle(filtreFiliereCode, filtreCycleCode))
            {
                filtreFiliereCode = null;
            }

            if (!string.IsNullOrWhiteSpace(filtreSpecialiteCode) && !SpecialiteBelongsToSelection(filtreSpecialiteCode, filtreCycleCode, filtreFiliereCode))
            {
                filtreSpecialiteCode = null;
            }

            RefreshParcoursOptions();
        }
    }

    private string? FiltreFiliereCode
    {
        get => filtreFiliereCode;
        set
        {
            filtreFiliereCode = NormalizeNullable(value);

            if (!string.IsNullOrWhiteSpace(filtreSpecialiteCode) && !SpecialiteBelongsToSelection(filtreSpecialiteCode, filtreCycleCode, filtreFiliereCode))
            {
                filtreSpecialiteCode = null;
            }

            RefreshParcoursOptions();
        }
    }

    private void RefreshParcoursOptions()
    {
        cycleOptions = parcoursFormation
            .Where(x => !string.IsNullOrWhiteSpace(x.CycleCode))
            .GroupBy(x => x.CycleCode)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.CycleCode, FormatCodeLibelle(first.CycleCode, first.CycleLibelle));
            })
            .OrderBy(x => x.Libelle)
            .ToList();

        filiereOptions = parcoursFormation
            .Where(x => FilterMatches(x.CycleCode, filtreCycleCode))
            .Where(x => !string.IsNullOrWhiteSpace(x.FiliereCode))
            .GroupBy(x => x.FiliereCode)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.FiliereCode, FormatCodeLibelle(first.FiliereCode, first.FiliereLibelle));
            })
            .OrderBy(x => x.Libelle)
            .ToList();

        specialiteOptions = parcoursFormation
            .Where(x => FilterMatches(x.CycleCode, filtreCycleCode))
            .Where(x => FilterMatches(x.FiliereCode, filtreFiliereCode))
            .Where(x => !string.IsNullOrWhiteSpace(x.SpecialiteCode))
            .GroupBy(x => x.SpecialiteCode!)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.SpecialiteCode!, FormatCodeLibelle(first.SpecialiteCode, first.SpecialiteLibelle ?? string.Empty));
            })
            .OrderBy(x => x.Libelle)
            .ToList();
    }

    private bool FiliereBelongsToCycle(string? filiereCode, string? cycleCode)
        => parcoursFormation.Any(x => FilterMatches(x.CycleCode, cycleCode) && SameCode(x.FiliereCode, filiereCode));

    private bool SpecialiteBelongsToSelection(string? specialiteCode, string? cycleCode, string? filiereCode)
        => parcoursFormation.Any(x =>
            FilterMatches(x.CycleCode, cycleCode)
            && FilterMatches(x.FiliereCode, filiereCode)
            && SameCode(x.SpecialiteCode, specialiteCode));

    private static string DisplayParcours(DossierScolariteDto item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.CycleLibelle)) parts.Add(FormatCodeLibelle(item.CycleCode, item.CycleLibelle));
        if (!string.IsNullOrWhiteSpace(item.FiliereLibelle)) parts.Add(FormatCodeLibelle(item.FiliereCode, item.FiliereLibelle));
        if (!string.IsNullOrWhiteSpace(item.SpecialiteLibelle)) parts.Add(FormatCodeLibelle(item.SpecialiteCode, item.SpecialiteLibelle));

        return parts.Count == 0 ? "-" : string.Join(" / ", parts);
    }

    private static string DisplayStatut(StatutDossierScolarite statut)
        => statut switch
        {
            StatutDossierScolarite.EnPreparation => "En préparation",
            StatutDossierScolarite.EnCours => "En cours",
            StatutDossierScolarite.Regulier => "Régulier",
            StatutDossierScolarite.Incomplet => "Incomplet",
            StatutDossierScolarite.EnRetard => "En retard",
            StatutDossierScolarite.Bloque => "Bloqué",
            StatutDossierScolarite.Cloture => "Clôturé",
            _ => statut.ToString()
        };

    private static BadgeStyle GetStatutBadgeStyle(StatutDossierScolarite statut)
        => statut switch
        {
            StatutDossierScolarite.Regulier => BadgeStyle.Success,
            StatutDossierScolarite.EnRetard or StatutDossierScolarite.Bloque => BadgeStyle.Danger,
            StatutDossierScolarite.Incomplet => BadgeStyle.Warning,
            StatutDossierScolarite.Cloture => BadgeStyle.Secondary,
            _ => BadgeStyle.Info
        };

    private static string FormatMoney(decimal value)
        => value.ToString("N0", CultureInfo.InvariantCulture);

    private static decimal TotalAttendu(FinanceDossierScolariteDto finance)
        => finance.Elements.Sum(x => x.MontantAttendu);

    private static decimal SoldeRestant(FinanceDossierScolariteDto finance)
        => finance.Elements.Sum(x => x.MontantRestant);

    private static string FormatCodeLibelle(string? code, string libelle)
        => string.IsNullOrWhiteSpace(code) ? libelle : $"{code} - {libelle}";

    private static bool FilterMatches(string? value, string? filter)
        => string.IsNullOrWhiteSpace(filter) || SameCode(value, filter);

    private static bool SameCode(string? left, string? right)
        => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private static string? NormalizeNullable(string? value)
    {
        var normalized = value?.Trim();
        return string.IsNullOrWhiteSpace(normalized) ? null : normalized;
    }

    private void NotifySuccess(string message) => NotificationService.Notify(NotificationSeverity.Success, "Succès", message);
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private sealed record CodeLibelleOption(string Code, string Libelle);
    private sealed record NiveauOption(int Numero, string Libelle);
}
