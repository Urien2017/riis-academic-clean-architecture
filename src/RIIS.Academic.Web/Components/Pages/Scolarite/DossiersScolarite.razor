@page "/scolarite/dossiers"
@inject IDossiersScolariteService DossiersScolariteService
@inject IFinancesScolariteService FinancesScolariteService
@inject IReferentielsService ReferentielsService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Dossiers scolarité" />
                <RadzenText Text="Création ou récupération d'un dossier scolarité depuis une inscription." />
            </RadzenStack>

            <RadzenButton Text="Actualiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@Load" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres" />

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Nom ou matricule" Style="width:100%">
                        <RadzenTextBox @bind-Value="@recherche" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Année académique" Style="width:100%">
                        <RadzenDropDown Data="@anneesAcademiques"
                                        @bind-Value="@filtreAnneeAcademiqueCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Libelle"
                                        TValue="string"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Cycle" Style="width:100%">
                        <RadzenDropDown Data="@cycleOptions"
                                        @bind-Value="@FiltreCycleCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Niveau" Style="width:100%">
                        <RadzenDropDown Data="@niveaux"
                                        @bind-Value="@filtreNiveauNumero"
                                        TextProperty="Libelle"
                                        ValueProperty="Numero"
                                        TValue="int?"
                                        AllowClear="true"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Filière" Style="width:100%">
                        <RadzenDropDown Data="@filiereOptions"
                                        @bind-Value="@FiltreFiliereCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Disabled="@(filiereOptions.Count == 0)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Spécialité" Style="width:100%">
                        <RadzenDropDown Data="@specialiteOptions"
                                        @bind-Value="@filtreSpecialiteCode"
                                        TextProperty="Libelle"
                                        ValueProperty="Code"
                                        TValue="string"
                                        AllowClear="true"
                                        Disabled="@(specialiteOptions.Count == 0)"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="height:100%">
                        <RadzenButton Text="Réinitialiser" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="@ResetFilters" />
                        <RadzenButton Text="Filtrer" Icon="search" ButtonStyle="ButtonStyle.Primary" Click="@Load" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox @bind-Value="@inclureInscriptionsSansDossier" Change="@(async (bool _) => await Load())" />
                <RadzenText Text="Afficher les inscriptions sans dossier" />
            </RadzenStack>

            <RadzenDataGrid Data="@items" TItem="DossierScolariteDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
                <Columns>
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Property="EtudiantNomComplet" Title="Étudiant" />
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Property="EtudiantMatricule" Title="Matricule" Width="140px" />
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Property="AnneeAcademiqueLibelle" Title="Année" Width="130px" />
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Parcours">
                        <Template Context="item">
                            <RadzenText Text="@DisplayParcours(item)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Property="NiveauLibelle" Title="Niveau" Width="140px" />
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Dossier" Width="130px">
                        <Template Context="item">
                            <RadzenBadge Text="@DisplayExistence(item)" BadgeStyle="@GetExistenceBadgeStyle(item)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Statut global" Width="150px">
                        <Template Context="item">
                            <RadzenBadge Text="@DisplayStatut(item.StatutGlobal)" BadgeStyle="@GetStatutBadgeStyle(item.StatutGlobal)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Créé le" Width="130px">
                        <Template Context="item">@FormatDate(item.DateCreationUtc)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DossierScolariteDto" Title="Actions" Width="170px" Sortable="false" Filterable="false">
                        <Template Context="item">
                            <RadzenButton Text="Ouvrir"
                                          Icon="folder_open"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Disabled="@(operationInscriptionId == item.InscriptionId)"
                                          Click="@(() => OpenOrCreate(item))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenCard>

    @if (selectedDossier is not null)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="@selectedDossier.EtudiantNomComplet" />
                        <RadzenText Text="@($"{selectedDossier.AnneeAcademiqueLibelle} - {DisplayParcours(selectedDossier)}")" />
                    </RadzenStack>
                    <RadzenBadge Text="@DisplayStatut(selectedDossier.StatutGlobal)" BadgeStyle="@GetStatutBadgeStyle(selectedDossier.StatutGlobal)" />
                </RadzenStack>

                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Statut administratif" />
                        <RadzenText Text="@DisplayStatut(selectedDossier.StatutAdministratif)" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Statut financier" />
                        <RadzenText Text="@DisplayStatut(selectedDossier.StatutFinancier)" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Niveau" />
                        <RadzenText Text="@selectedDossier.NiveauLibelle" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Date de création" />
                        <RadzenText Text="@FormatDate(selectedDossier.DateCreationUtc)" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="Documents et validation administrative" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenButton Text="Synchroniser" Icon="sync" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@SynchroniserDocumentsAdministratifs" />
                            <RadzenButton Text="Recalculer" Icon="fact_check" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Disabled="@(administration is null)" Click="@RecalculerAdministration" />
                        </RadzenStack>
                    </RadzenStack>

                    @if (administration is null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                            Aucun element administratif n'est encore charge pour ce dossier. Lance la synchronisation pour creer les lignes depuis les types d'elements configures.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Pieces obligatoires" />
                                <RadzenBadge Text="@($"{administration.NombrePiecesObligatoiresCompletes}/{administration.NombrePiecesObligatoires}")"
                                             BadgeStyle="@(administration.PiecesObligatoiresCompletes ? BadgeStyle.Success : BadgeStyle.Warning)" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Paiement initial" />
                                <RadzenBadge Text="@(administration.PaiementInitialEffectue ? FormatMoney(administration.MontantPaiementsActifs) : "Non effectue")"
                                             BadgeStyle="@(administration.PaiementInitialEffectue ? BadgeStyle.Success : BadgeStyle.Danger)" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Suite du parcours" />
                                <RadzenBadge Text="@DisplayAutorisationParcours(administration)"
                                             BadgeStyle="@GetAutorisationBadgeStyle(administration)" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Motif" />
                                <RadzenText Text="@administration.MotifAutorisation" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenDataGrid Data="@administration.Documents" TItem="DocumentAdministratifDossierDto" AllowPaging="true" PageSize="5">
                            <Columns>
                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Piece">
                                    <Template Context="item">
                                        <RadzenStack Gap="0">
                                            <RadzenText Text="@FormatCodeLibelle(item.Code, item.Libelle)" />
                                            <RadzenBadge Text="@(item.EstObligatoire ? "Obligatoire" : "Optionnelle")"
                                                         BadgeStyle="@(item.EstObligatoire ? BadgeStyle.Warning : BadgeStyle.Secondary)" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Document" Width="230px">
                                    <Template Context="item">
                                        @if (item.EstDocumentaire)
                                        {
                                            <RadzenDropDown Data="@documentStatuts"
                                                            @bind-Value="@item.DocumentStatut"
                                                            TValue="StatutDocumentScolarite"
                                                            Style="width:100%" />
                                        }
                                        else
                                        {
                                            <RadzenText Text="-" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Validation" Width="230px">
                                    <Template Context="item">
                                        @if (item.EstSoumisValidation)
                                        {
                                            <RadzenDropDown Data="@validationStatuts"
                                                            @bind-Value="@item.ValidationStatut"
                                                            TValue="StatutValidationScolarite"
                                                            Style="width:100%" />
                                        }
                                        else
                                        {
                                            <RadzenText Text="-" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Reference / URL">
                                    <Template Context="item">
                                        <RadzenTextBox @bind-Value="@item.UrlFichier" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Observation">
                                    <Template Context="item">
                                        <RadzenTextBox @bind-Value="@item.Observation" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Etat" Width="130px">
                                    <Template Context="item">
                                        <RadzenBadge Text="@(item.EstComplet ? "Complet" : "Incomplet")"
                                                     BadgeStyle="@(item.EstComplet ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="DocumentAdministratifDossierDto" Title="Actions" Width="120px" Sortable="false" Filterable="false">
                                    <Template Context="item">
                                        <RadzenButton Text="Enregistrer"
                                                      Icon="save"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      Click="@(() => SaveDocumentAdministratif(item))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>

                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0" Text="Recapitulatif financier" />
                        <RadzenButton Text="Actualiser finances" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@LoadFinance" />
                    </RadzenStack>

                    @if (finance is null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                            Les donnees financieres ne sont pas encore chargees pour ce dossier.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Statut financier" />
                                <RadzenBadge Text="@DisplayStatut(selectedDossier.StatutFinancier)" BadgeStyle="@GetStatutBadgeStyle(selectedDossier.StatutFinancier)" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Total attendu" />
                                <RadzenText Text="@FormatMoney(TotalAttendu(finance))" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Total paye" />
                                <RadzenText Text="@FormatMoney(finance.TotalPaiements)" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Solde" />
                                <RadzenText Text="@FormatMoney(SoldeRestant(finance))" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="Non affecte" />
                                <RadzenText Text="@FormatMoney(finance.TotalPaiementsNonAffectes)" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private List<AnneeAcademiqueDto> anneesAcademiques = [];
    private List<NiveauOption> niveaux = [];
    private List<ParcoursFormationDto> parcoursFormation = [];
    private List<CodeLibelleOption> cycleOptions = [];
    private List<CodeLibelleOption> filiereOptions = [];
    private List<CodeLibelleOption> specialiteOptions = [];
    private List<DossierScolariteDto> items = [];
    private readonly List<StatutDocumentScolarite> documentStatuts = Enum.GetValues<StatutDocumentScolarite>().ToList();
    private readonly List<StatutValidationScolarite> validationStatuts = Enum.GetValues<StatutValidationScolarite>().ToList();
    private DossierScolariteDto? selectedDossier;
    private AdministrationDossierScolariteDto? administration;
    private FinanceDossierScolariteDto? finance;
    private string? recherche;
    private string? filtreAnneeAcademiqueCode;
    private string? filtreCycleCode;
    private int? filtreNiveauNumero;
    private string? filtreFiliereCode;
    private string? filtreSpecialiteCode;
    private bool inclureInscriptionsSansDossier = true;
    private long? operationInscriptionId;

    protected override async Task OnInitializedAsync()
    {
        anneesAcademiques = await ReferentielsService.GetAnneesAcademiquesAsync();
        niveaux = (await ReferentielsService.GetNiveauxEtudeAsync())
            .Select(x => new NiveauOption(x.Numero, x.Libelle))
            .OrderBy(x => x.Numero)
            .ToList();
        parcoursFormation = await ReferentielsService.GetParcoursFormationAsync(inclureInactifs: true);
        RefreshParcoursOptions();
        await Load();
    }

    private async Task Load()
    {
        items = await DossiersScolariteService.GetDossiersScolariteAsync(
            inclureInscriptionsSansDossier,
            recherche,
            filtreAnneeAcademiqueCode,
            filtreCycleCode,
            filtreNiveauNumero,
            filtreFiliereCode,
            filtreSpecialiteCode);

        if (selectedDossier is not null)
        {
            selectedDossier = items.FirstOrDefault(x => x.Id == selectedDossier.Id && x.Id > 0)
                ?? items.FirstOrDefault(x => x.InscriptionId == selectedDossier.InscriptionId);

            administration = selectedDossier?.Id > 0
                ? await DossiersScolariteService.GetAdministrationDossierScolariteAsync(selectedDossier.Id)
                : null;
            finance = selectedDossier?.Id > 0
                ? await FinancesScolariteService.GetFinanceDossierScolariteAsync(selectedDossier.Id)
                : null;
        }
    }

    private async Task ResetFilters()
    {
        recherche = null;
        filtreAnneeAcademiqueCode = null;
        filtreCycleCode = null;
        filtreNiveauNumero = null;
        filtreFiliereCode = null;
        filtreSpecialiteCode = null;
        RefreshParcoursOptions();
        await Load();
    }

    private string? FiltreCycleCode
    {
        get => filtreCycleCode;
        set
        {
            filtreCycleCode = NormalizeNullable(value);

            if (!string.IsNullOrWhiteSpace(filtreFiliereCode) && !FiliereBelongsToCycle(filtreFiliereCode, filtreCycleCode))
            {
                filtreFiliereCode = null;
            }

            if (!string.IsNullOrWhiteSpace(filtreSpecialiteCode) && !SpecialiteBelongsToSelection(filtreSpecialiteCode, filtreCycleCode, filtreFiliereCode))
            {
                filtreSpecialiteCode = null;
            }

            RefreshParcoursOptions();
        }
    }

    private string? FiltreFiliereCode
    {
        get => filtreFiliereCode;
        set
        {
            filtreFiliereCode = NormalizeNullable(value);

            if (!string.IsNullOrWhiteSpace(filtreSpecialiteCode) && !SpecialiteBelongsToSelection(filtreSpecialiteCode, filtreCycleCode, filtreFiliereCode))
            {
                filtreSpecialiteCode = null;
            }

            RefreshParcoursOptions();
        }
    }

    private async Task OpenOrCreate(DossierScolariteDto item)
    {
        try
        {
            operationInscriptionId = item.InscriptionId;
            selectedDossier = await DossiersScolariteService.GetOrCreateDossierDepuisInscriptionAsync(item.InscriptionId);
            administration = await DossiersScolariteService.GetAdministrationDossierScolariteAsync(selectedDossier.Id);
            finance = await FinancesScolariteService.GetFinanceDossierScolariteAsync(selectedDossier.Id);
            NotifySuccess(item.Existe ? "Dossier récupéré." : "Dossier créé.");
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
        finally
        {
            operationInscriptionId = null;
        }
    }

    private async Task SynchroniserDocumentsAdministratifs()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            return;
        }

        try
        {
            administration = await DossiersScolariteService.SynchroniserDocumentsAdministratifsAsync(selectedDossier.Id);
            NotifySuccess("Documents administratifs synchronises.");
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task SaveDocumentAdministratif(DocumentAdministratifDossierDto item)
    {
        try
        {
            administration = await DossiersScolariteService.SaveDocumentAdministratifAsync(item);
            if (selectedDossier is not null)
            {
                selectedDossier = await DossiersScolariteService.GetDossierScolariteAsync(selectedDossier.Id) ?? selectedDossier;
            }

            NotifySuccess("Piece administrative enregistree.");
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task RecalculerAdministration()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            return;
        }

        try
        {
            administration = await DossiersScolariteService.RecalculerValidationAdministrativeAsync(selectedDossier.Id);
            selectedDossier = await DossiersScolariteService.GetDossierScolariteAsync(selectedDossier.Id) ?? selectedDossier;
            NotifySuccess("Validation administrative recalculee.");
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task LoadFinance()
    {
        if (selectedDossier is null || selectedDossier.Id == 0)
        {
            return;
        }

        finance = await FinancesScolariteService.GetFinanceDossierScolariteAsync(selectedDossier.Id);
    }

    private void RefreshParcoursOptions()
    {
        cycleOptions = parcoursFormation
            .Where(x => !string.IsNullOrWhiteSpace(x.CycleCode))
            .GroupBy(x => x.CycleCode)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.CycleCode, FormatCodeLibelle(first.CycleCode, first.CycleLibelle));
            })
            .OrderBy(x => x.Libelle)
            .ToList();

        filiereOptions = parcoursFormation
            .Where(x => FilterMatches(x.CycleCode, filtreCycleCode))
            .Where(x => !string.IsNullOrWhiteSpace(x.FiliereCode))
            .GroupBy(x => x.FiliereCode)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.FiliereCode, FormatCodeLibelle(first.FiliereCode, first.FiliereLibelle));
            })
            .OrderBy(x => x.Libelle)
            .ToList();

        specialiteOptions = parcoursFormation
            .Where(x => FilterMatches(x.CycleCode, filtreCycleCode))
            .Where(x => FilterMatches(x.FiliereCode, filtreFiliereCode))
            .Where(x => !string.IsNullOrWhiteSpace(x.SpecialiteCode))
            .GroupBy(x => x.SpecialiteCode!)
            .Select(x =>
            {
                var first = x.First();
                return new CodeLibelleOption(first.SpecialiteCode!, FormatCodeLibelle(first.SpecialiteCode, first.SpecialiteLibelle ?? string.Empty));
            })
            .OrderBy(x => x.Libelle)
            .ToList();
    }

    private bool FiliereBelongsToCycle(string? filiereCode, string? cycleCode)
        => parcoursFormation.Any(x => FilterMatches(x.CycleCode, cycleCode) && SameCode(x.FiliereCode, filiereCode));

    private bool SpecialiteBelongsToSelection(string? specialiteCode, string? cycleCode, string? filiereCode)
        => parcoursFormation.Any(x =>
            FilterMatches(x.CycleCode, cycleCode)
            && FilterMatches(x.FiliereCode, filiereCode)
            && SameCode(x.SpecialiteCode, specialiteCode));

    private static string DisplayParcours(DossierScolariteDto item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.CycleLibelle)) parts.Add(FormatCodeLibelle(item.CycleCode, item.CycleLibelle));
        if (!string.IsNullOrWhiteSpace(item.FiliereLibelle)) parts.Add(FormatCodeLibelle(item.FiliereCode, item.FiliereLibelle));
        if (!string.IsNullOrWhiteSpace(item.SpecialiteLibelle)) parts.Add(FormatCodeLibelle(item.SpecialiteCode, item.SpecialiteLibelle));

        return parts.Count == 0 ? "-" : string.Join(" / ", parts);
    }

    private static string DisplayExistence(DossierScolariteDto item)
        => item.Existe ? "Existant" : "À créer";

    private static string DisplayStatut(StatutDossierScolarite statut)
        => statut switch
        {
            StatutDossierScolarite.EnPreparation => "En préparation",
            StatutDossierScolarite.EnCours => "En cours",
            StatutDossierScolarite.Regulier => "Régulier",
            StatutDossierScolarite.Incomplet => "Incomplet",
            StatutDossierScolarite.EnRetard => "En retard",
            StatutDossierScolarite.Bloque => "Bloqué",
            StatutDossierScolarite.Cloture => "Clôturé",
            _ => statut.ToString()
        };

    private static BadgeStyle GetExistenceBadgeStyle(DossierScolariteDto item)
        => item.Existe ? BadgeStyle.Success : BadgeStyle.Warning;

    private static BadgeStyle GetStatutBadgeStyle(StatutDossierScolarite statut)
        => statut switch
        {
            StatutDossierScolarite.Regulier => BadgeStyle.Success,
            StatutDossierScolarite.EnRetard or StatutDossierScolarite.Bloque => BadgeStyle.Danger,
            StatutDossierScolarite.Incomplet => BadgeStyle.Warning,
            StatutDossierScolarite.Cloture => BadgeStyle.Secondary,
            _ => BadgeStyle.Info
        };

    private static string DisplayAutorisationParcours(AdministrationDossierScolariteDto administration)
    {
        if (administration.PiecesObligatoiresCompletes)
        {
            return "Autorisee";
        }

        if (administration.PaiementInitialEffectue)
        {
            return "Sous reserve";
        }

        return "Bloquee";
    }

    private static BadgeStyle GetAutorisationBadgeStyle(AdministrationDossierScolariteDto administration)
    {
        if (administration.PiecesObligatoiresCompletes)
        {
            return BadgeStyle.Success;
        }

        if (administration.PaiementInitialEffectue)
        {
            return BadgeStyle.Warning;
        }

        return BadgeStyle.Danger;
    }

    private static string FormatDate(DateTime? value)
        => value is null ? "-" : value.Value.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);

    private static string FormatMoney(decimal value)
        => value.ToString("N0", CultureInfo.InvariantCulture);

    private static decimal TotalAttendu(FinanceDossierScolariteDto finance)
        => finance.Elements.Sum(x => x.MontantAttendu);

    private static decimal SoldeRestant(FinanceDossierScolariteDto finance)
        => finance.Elements.Sum(x => x.MontantRestant);

    private static string FormatCodeLibelle(string? code, string libelle)
        => string.IsNullOrWhiteSpace(code) ? libelle : $"{code} - {libelle}";

    private static bool FilterMatches(string? value, string? filter)
        => string.IsNullOrWhiteSpace(filter) || SameCode(value, filter);

    private static bool SameCode(string? left, string? right)
        => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private static string? NormalizeNullable(string? value)
    {
        var normalized = value?.Trim();
        return string.IsNullOrWhiteSpace(normalized) ? null : normalized;
    }

    private void NotifySuccess(string message) => NotificationService.Notify(NotificationSeverity.Success, "Succès", message);
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private sealed record CodeLibelleOption(string Code, string Libelle);
    private sealed record NiveauOption(int Numero, string Libelle);
}
