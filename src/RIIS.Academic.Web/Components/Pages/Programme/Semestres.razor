@page "/programme/semestres"
@inject IProgrammePedagogiqueService ProgrammeService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Semestres pédagogiques" />
                <RadzenText Text="Gestion des semestres rattachés aux maquettes." />
            </RadzenStack>
            <RadzenButton Text="Nouveau semestre" Icon="add_circle" Click="@Create" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem">
            <RadzenFormField Text="Maquette" Style="width: min(100%, 480px)">
                <RadzenDropDown Data="@maquettes" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@selectedMaquetteId" AllowClear="true" Placeholder="Toutes les maquettes" Style="width:100%" />
            </RadzenFormField>
            <RadzenButton Text="Filtrer" Icon="filter_alt" Click="@Load" />
            <RadzenButton Text="Réinitialiser" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ResetFilter" />
        </RadzenStack>
    </RadzenCard>

    @if (showForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="SemestrePedagogiqueDto" Data="@model" Submit="@Save">
                <RadzenStack Gap="1rem">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Maquette" Style="width:100%">
                                <RadzenDropDown Data="@maquettes" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@model.MaquettePedagogiqueId" Name="MaquettePedagogiqueId" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="MaquettePedagogiqueId" Text="Maquette obligatoire." />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Niveau" Style="width:100%">
                                <RadzenDropDown Data="@niveaux" TextProperty="Libelle" ValueProperty="Id" @bind-Value="@model.NiveauEtudeId" AllowClear="true" Placeholder="Aucun" Style="width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Numéro" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.Numero" Name="Numero" Min="1" Max="10" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@model.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Crédits attendus" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.CreditsAttendus" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Volume horaire attendu" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.VolumeHoraireAttendu" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Ordre affichage" Style="width:100%">
                                <RadzenNumeric @bind-Value="@model.OrdreAffichage" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
                        <RadzenButton Text="Enregistrer" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="SemestrePedagogiqueDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="MaquettePedagogiqueLibelle" Title="Maquette" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="Numero" Title="N°" Width="90px" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="Libelle" Title="Libellé" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="NiveauEtudeLibelle" Title="Niveau" Width="140px" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="CreditsAttendus" Title="Crédits" Width="110px" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Property="NombreUnitesEnseignement" Title="UE" Width="90px" />
                <RadzenDataGridColumn TItem="SemestrePedagogiqueDto" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => Delete(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<SemestrePedagogiqueDto> items = [];
    private List<LookupDto> maquettes = [];
    private List<LookupDto> niveaux = [];
    private SemestrePedagogiqueDto model = new();
    private long? selectedMaquetteId;
    private bool showForm;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        maquettes = await ProgrammeService.GetMaquettesLookupAsync();
        niveaux = await ProgrammeService.GetNiveauxEtudeLookupAsync();
    }

    private async Task Load()
    {
        items = await ProgrammeService.GetSemestresAsync(selectedMaquetteId);
    }

    private async Task ResetFilter()
    {
        selectedMaquetteId = null;
        await Load();
    }

    private async Task Create()
    {
        model = await ProgrammeService.CreateDefaultSemestreAsync(selectedMaquetteId ?? maquettes.FirstOrDefault()?.Id);
        showForm = true;
    }

    private void Edit(SemestrePedagogiqueDto item)
    {
        model = new SemestrePedagogiqueDto
        {
            Id = item.Id,
            MaquettePedagogiqueId = item.MaquettePedagogiqueId,
            MaquettePedagogiqueLibelle = item.MaquettePedagogiqueLibelle,
            NiveauEtudeId = item.NiveauEtudeId,
            NiveauEtudeLibelle = item.NiveauEtudeLibelle,
            Numero = item.Numero,
            Libelle = item.Libelle,
            CreditsAttendus = item.CreditsAttendus,
            VolumeHoraireAttendu = item.VolumeHoraireAttendu,
            OrdreAffichage = item.OrdreAffichage,
            NombreUnitesEnseignement = item.NombreUnitesEnseignement
        };
        showForm = true;
    }

    private async Task Save(SemestrePedagogiqueDto _)
    {
        try
        {
            await ProgrammeService.SaveSemestreAsync(model);
            NotifySuccess();
            showForm = false;
            await LoadLookups();
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task Delete(SemestrePedagogiqueDto item)
    {
        try
        {
            await ProgrammeService.DeleteSemestreAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void Cancel() => showForm = false;
    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");
    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);
}
