@page "/programme/ue"
@inject IProgrammePedagogiqueService ProgrammeService
@inject NotificationService NotificationService

<RadzenStack Gap="1rem">
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0" Text="Unités d'enseignement" />
                <RadzenText Text="Liste et gestion des UE selon la hiérarchie académique." />
            </RadzenStack>
            <RadzenButton Text="Nouvelle UE" Icon="add_circle" Click="@CreateUe" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Text="Filtres de recherche" />

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Année académique" Style="width:100%">
                        <RadzenDropDown Data="@anneesAcademiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedAnneeAcademiqueId"
                                        Change="@OnAnneeAcademiqueChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Toutes les années"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Cycle" Style="width:100%">
                        <RadzenDropDown Data="@cyclesFormation"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedCycleFormationId"
                                        Change="@OnCycleFormationChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Tous les cycles"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Filière / Spécialité" Style="width:100%">
                        <RadzenDropDown Data="@parcoursAcademiques"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedParcoursAcademiqueId"
                                        Change="@OnParcoursAcademiqueChanged"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Tous les parcours"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="Semestre" Style="width:100%">
                        <RadzenDropDown Data="@semestres"
                                        TextProperty="Libelle"
                                        ValueProperty="Id"
                                        @bind-Value="@selectedSemestrePedagogiqueId"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="Tous les semestres"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Réinitialiser" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="@ResetFilters" />
                <RadzenButton Text="Appliquer" Icon="filter_alt" ButtonStyle="ButtonStyle.Primary" Click="@ApplyFilters" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (showUeForm)
    {
        <RadzenCard>
            <RadzenTemplateForm TItem="UniteEnseignementDto" Data="@ueModel" Submit="@SaveUe">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Text="Formulaire UE" />

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Semestre" Style="width:100%">
                                <RadzenDropDown Data="@semestres"
                                                TextProperty="Libelle"
                                                ValueProperty="Id"
                                                @bind-Value="@ueModel.SemestrePedagogiqueId"
                                                Name="SemestrePedagogiqueId"
                                                AllowFiltering="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Style="width:100%" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="SemestrePedagogiqueId" Text="Semestre obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenFormField Text="Code" Style="width:100%">
                                <RadzenTextBox @bind-Value="@ueModel.Code" Name="Code" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Code" Text="Code obligatoire." />
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Libellé" Style="width:100%">
                                <RadzenTextBox @bind-Value="@ueModel.Libelle" Name="Libelle" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Libelle" Text="Libellé obligatoire." />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Crédits" Style="width:100%">
                                <RadzenNumeric @bind-Value="@ueModel.Credits" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Volume horaire" Style="width:100%">
                                <RadzenNumeric @bind-Value="@ueModel.VolumeHoraire" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenFormField Text="Ordre affichage" Style="width:100%">
                                <RadzenNumeric @bind-Value="@ueModel.OrdreAffichage" Min="0" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="3">
                            <RadzenStack Gap="0.5rem">
                                <RadzenLabel Text="Obligatoire" />
                                <RadzenCheckBox @bind-Value="@ueModel.EstObligatoire" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Annuler" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@CancelUe" />
                        <RadzenButton Text="Enregistrer UE" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@items" TItem="UniteEnseignementHierarchyDto" AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Property="Code" Title="Code" Width="120px" />
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Property="Libelle" Title="UE (Unité d'enseignement)" />
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Property="Credits" Title="Crédits" Width="110px" />
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Property="VolumeHoraire" Title="VH" Width="90px" />
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Title="EC" Width="90px">
                    <Template Context="item">
                        @item.ElementsConstitutifs.Count
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Property="EstObligatoire" Title="Oblig." Width="100px">
                    <Template Context="item">
                        <RadzenCheckBox Value="@item.EstObligatoire" Disabled="true" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UniteEnseignementHierarchyDto" Title="Actions" Width="150px" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => EditUe(item))" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="@(() => DeleteUe(item))" class="rz-ml-1" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <Template Context="ue">
                <RadzenCard class="rz-m-2">
                    @if (ue.ElementsConstitutifs.Count == 0)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                            Aucun EC n'est encore rattaché à cette UE.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@ue.ElementsConstitutifs" TItem="ElementConstitutifHierarchyDto" AllowPaging="false" AllowSorting="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="Code" Title="Code" Width="120px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="Libelle" Title="EC (Élément constitutif)" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="Type" Title="Type" Width="130px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="Credits" Title="Crédits" Width="110px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="Coefficient" Title="Coef." Width="100px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="VolumeHoraire" Title="VH" Width="90px" />
                                <RadzenDataGridColumn TItem="ElementConstitutifHierarchyDto" Property="EstObligatoire" Title="Oblig." Width="100px">
                                    <Template Context="ec">
                                        <RadzenCheckBox Value="@ec.EstObligatoire" Disabled="true" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenCard>
            </Template>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<UniteEnseignementHierarchyDto> items = [];
    private List<LookupDto> anneesAcademiques = [];
    private List<LookupDto> cyclesFormation = [];
    private List<LookupDto> parcoursAcademiques = [];
    private List<LookupDto> semestres = [];
    private UniteEnseignementDto ueModel = new();
    private long? selectedAnneeAcademiqueId;
    private long? selectedCycleFormationId;
    private long? selectedParcoursAcademiqueId;
    private long? selectedSemestrePedagogiqueId;
    private bool showUeForm;

    protected override async Task OnInitializedAsync()
    {
        anneesAcademiques = await ProgrammeService.GetAnneesAcademiquesLookupAsync();
        cyclesFormation = await ProgrammeService.GetCyclesFormationLookupAsync();
        await RefreshDependentLookupsAsync();
        await Load();
    }

    private async Task OnAnneeAcademiqueChanged(object? _)
    {
        await RefreshSemestresAsync();
    }

    private async Task OnCycleFormationChanged(object? _)
    {
        selectedParcoursAcademiqueId = null;
        await RefreshDependentLookupsAsync();
    }

    private async Task OnParcoursAcademiqueChanged(object? _)
    {
        await RefreshSemestresAsync();
    }

    private async Task ApplyFilters()
    {
        await RefreshDependentLookupsAsync();
        await Load();
    }

    private async Task ResetFilters()
    {
        selectedAnneeAcademiqueId = null;
        selectedCycleFormationId = null;
        selectedParcoursAcademiqueId = null;
        selectedSemestrePedagogiqueId = null;
        showUeForm = false;

        await RefreshDependentLookupsAsync();
        await Load();
    }

    private async Task RefreshDependentLookupsAsync()
    {
        parcoursAcademiques = await ProgrammeService.GetParcoursAcademiquesLookupAsync(selectedCycleFormationId);
        EnsureSelectedValueIsAvailable(parcoursAcademiques, ref selectedParcoursAcademiqueId);
        await RefreshSemestresAsync();
    }

    private async Task RefreshSemestresAsync()
    {
        semestres = await ProgrammeService.GetSemestresHierarchyLookupAsync(
            selectedAnneeAcademiqueId,
            selectedCycleFormationId,
            selectedParcoursAcademiqueId);

        EnsureSelectedValueIsAvailable(semestres, ref selectedSemestrePedagogiqueId);

        if (showUeForm && ueModel.SemestrePedagogiqueId != 0 && semestres.All(x => x.Id != ueModel.SemestrePedagogiqueId))
        {
            ueModel.SemestrePedagogiqueId = selectedSemestrePedagogiqueId ?? semestres.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task Load()
    {
        items = await ProgrammeService.GetUnitesEnseignementHierarchyAsync(
            selectedAnneeAcademiqueId,
            selectedCycleFormationId,
            selectedParcoursAcademiqueId,
            selectedSemestrePedagogiqueId);
    }

    private async Task CreateUe()
    {
        ueModel = await ProgrammeService.CreateDefaultUniteEnseignementAsync(selectedSemestrePedagogiqueId ?? semestres.FirstOrDefault()?.Id);
        showUeForm = true;
    }

    private void EditUe(UniteEnseignementHierarchyDto item)
    {
        ueModel = new UniteEnseignementDto
        {
            Id = item.Id,
            SemestrePedagogiqueId = item.SemestrePedagogiqueId,
            SemestrePedagogiqueLibelle = item.SemestrePedagogiqueLibelle,
            Code = item.Code,
            Libelle = item.Libelle,
            Credits = item.Credits,
            VolumeHoraire = item.VolumeHoraire,
            OrdreAffichage = item.OrdreAffichage,
            EstObligatoire = item.EstObligatoire,
            NombreElementsConstitutifs = item.ElementsConstitutifs.Count
        };

        showUeForm = true;
    }

    private async Task SaveUe(UniteEnseignementDto _)
    {
        try
        {
            await ProgrammeService.SaveUniteEnseignementAsync(ueModel);
            NotifySuccess();
            showUeForm = false;
            await RefreshSemestresAsync();
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private async Task DeleteUe(UniteEnseignementHierarchyDto item)
    {
        try
        {
            await ProgrammeService.DeleteUniteEnseignementAsync(item.Id);
            await Load();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
    }

    private void CancelUe() => showUeForm = false;

    private void NotifySuccess() => NotificationService.Notify(NotificationSeverity.Success, "Succès", "Données enregistrées.");

    private void NotifyError(string message) => NotificationService.Notify(NotificationSeverity.Error, "Erreur", message);

    private static void EnsureSelectedValueIsAvailable(IReadOnlyCollection<LookupDto> options, ref long? selectedValue)
    {
        var value = selectedValue;

        if (value is not null && options.All(x => x.Id != value))
        {
            selectedValue = null;
        }
    }
}
